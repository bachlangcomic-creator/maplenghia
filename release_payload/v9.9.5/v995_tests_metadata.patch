+import os
+from pathlib import Path
+
+APP_PAYLOAD = Path(os.environ["APP_PAYLOAD"])
+SOURCE = (APP_PAYLOAD / "maple_nghia_pro.py").read_text(encoding="utf-8")
+
+
+def _body(start_name: str, end_name: str) -> str:
+    start = SOURCE.index(f"    def {start_name}")
+    end = SOURCE.index(f"    def {end_name}", start)
+    return SOURCE[start:end]
+
+
+def test_generic_main_farm_worker_exists_and_is_not_c2_gated():
+    assert "def _start_spotify_main_farm_worker" in SOURCE
+    assert "def _spotify_main_farm_worker" in SOURCE
+    start = SOURCE.index("    def _spotify_main_farm_worker(self, initial_cfg, generation):")
+    end = SOURCE.index("    @staticmethod\n    def _spotify_profile_kind_from", start)
+    worker = SOURCE[start:end]
+    assert 'owner="MAIN_FARM"' in worker
+    assert 'current_map", "")).strip().upper() != "C2"' not in worker
+    assert "capture_screen(" not in worker
+    assert "_find_game_window(" not in worker
+    assert "_spotify_cached_game_hwnd()" in worker
+    assert "time.sleep(0.001)" in worker
+
+
+def test_start_and_stop_use_one_generic_worker_generation():
+    assert "spotify_main_farm_worker_generation" in SOURCE
+    assert "spotify_main_farm_thread" in SOURCE
+    assert "self._start_spotify_main_farm_worker(cfg)" in SOURCE
+    stop = _body("stop_bot", "_apply_map_profile")
+    assert "spotify_main_farm_worker_generation += 1" in stop
