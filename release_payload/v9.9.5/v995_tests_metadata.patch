--- /dev/null
+++ b/tests/test_allmap_mainfarm_integration.py
@@ -0,0 +1,42 @@
+import os
+from pathlib import Path
+
+APP_PAYLOAD = Path(os.environ["APP_PAYLOAD"])
+SOURCE = (APP_PAYLOAD / "maple_nghia_pro.py").read_text(encoding="utf-8")
+
+
+def body(start_name: str, end_name: str) -> str:
+    start = SOURCE.index(f"    def {start_name}")
+    end = SOURCE.index(f"    def {end_name}", start)
+    return SOURCE[start:end]
+
+
+def test_sell_handoff_sets_pause_before_async_seller():
+    section = body("_spotify_mainfarm_sell_safe_stage", "_spotify_mainfarm_pet_stage")
+    ready = section[section.index('if safe_outcome == "READY":'):]
+    assert ready.index('_c2_pause_add("sell")') < ready.index("run_sell_thread(cfg)")
+
+
+def test_periodic_helper_stays_disabled_for_spotify_profiles():
+    section = body("_run_periodic_actions", "_game_capture_rect")
+    assert "self.behavior_engine.handles_profile(cfg)" in section
+    guard = section.index("self.behavior_engine.handles_profile(cfg)")
+    assert "return" in section[guard:guard + 160]
+
+
+def test_stop_invalidates_generic_worker_before_behavior_shutdown():
+    section = body("stop_bot", "_apply_map_profile")
+    assert section.index("spotify_main_farm_worker_generation += 1") < section.index("self.behavior_engine.stop()")
+
+
+def test_c2_stage_trace_follows_generic_main_farm_owner():
+    for start_name, end_name in [
+        ("_spotify_mainfarm_state_stage", "_spotify_mainfarm_sell_safe_stage"),
+        ("_spotify_mainfarm_sell_safe_stage", "_spotify_mainfarm_pet_stage"),
+        ("_spotify_mainfarm_pet_stage", "_spotify_mainfarm_recovery_stage"),
+        ("_spotify_mainfarm_recovery_stage", "_spotify_mainfarm_buff_stage"),
+        ("_spotify_mainfarm_buff1_stage", "_spotify_mainfarm_buff2_stage"),
+        ("_spotify_mainfarm_buff2_stage", "_spotify_mainfarm_dispatch_stage"),
+    ]:
+        section = body(start_name, end_name)
+        assert 'owner == "MAIN_FARM"' in section
