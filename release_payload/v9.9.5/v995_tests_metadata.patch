diff --git a/tests/test_allmap_dispatch_focus_parity.py b/tests/test_allmap_dispatch_focus_parity.py
new file mode 100644
index 0000000..0ecd94c
--- /dev/null
+++ b/tests/test_allmap_dispatch_focus_parity.py
@@ -0,0 +1,67 @@
+import os
+import sys
+from pathlib import Path
+
+APP_PAYLOAD = Path(os.environ["APP_PAYLOAD"])
+sys.path.insert(0, str(APP_PAYLOAD))
+
+from spotify_recovered_api import SpotifyRecoveredAPI
+
+
+class FakeCore:
+    def __init__(self):
+        self.calls = []
+
+    def _spotify_left_right_step(self, cfg, pos, now):
+        self.calls.append(("LEFT_RIGHT", cfg["current_map"]))
+        return True
+
+    def _spotify_stand_still_step(self, cfg, pos, now):
+        self.calls.append(("STAND_STILL", cfg["current_map"]))
+        return True
+
+    def _spotify_bunny_step(self, cfg, pos, now):
+        self.calls.append(("BUNNY", cfg["current_map"]))
+        return True
+
+    def _spotify_pirate_step(self, cfg, pos, now, one_hit=False):
+        self.calls.append(("PIRATE2_1HIT" if one_hit else "PIRATE2", cfg["current_map"]))
+        return True
+
+
+def test_dispatch_routes_stay_profile_specific():
+    cases = [
+        ("LEFT_RIGHT", "C1"),
+        ("LEFT_RIGHT", "C2"),
+        ("LEFT_RIGHT", "B1"),
+        ("LEFT_RIGHT", "B3"),
+        ("BUNNY", "Bunny"),
+        ("STAND_STILL", "Stand Still"),
+        ("PIRATE2", "Red-Nose Pirate Den 2"),
+        ("PIRATE2_1HIT", "Red-Nose Pirate Den 2 (1 Hit)"),
+    ]
+    for kind, name in cases:
+        core = FakeCore()
+        api = SpotifyRecoveredAPI(core)
+        assert api.dispatch(kind, {"current_map": name}, (100.0, 160.0), 1.0) is True
+        assert core.calls == [(kind, name)]
+
+
+def test_generic_worker_hot_path_uses_cached_hwnd_and_no_window_enumeration():
+    source = (APP_PAYLOAD / "maple_nghia_pro.py").read_text(encoding="utf-8")
+    start = source.index("    def _spotify_main_farm_worker(self, initial_cfg, generation):")
+    end = source.index("    @staticmethod\n    def _spotify_profile_kind_from", start)
+    worker = source[start:end]
+    assert "_spotify_cached_game_hwnd()" in worker
+    assert "_spotify_focus_refresh(initial_cfg, force=False)" in worker
+    assert "_find_game_window(" not in worker
+    assert "EnumWindows" not in worker
+    assert "capture_screen(" not in worker
+
+
+def test_parity_focus_branch_consumes_cache_only():
+    source = (APP_PAYLOAD / "maple_nghia_pro.py").read_text(encoding="utf-8")
+    game_focus = source[source.index("    def _game_has_focus"):source.index("    def _focus_game")]
+    focus_game = source[source.index("    def _focus_game"):source.index("    @staticmethod\n    def _direct_key_name")]
+    assert "_spotify_cached_game_has_focus()" in game_focus
+    assert "_spotify_cached_game_has_focus()" in focus_game
