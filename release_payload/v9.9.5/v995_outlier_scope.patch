diff -ruN '--exclude=.git' '--exclude=__pycache__' '--exclude=.pytest_cache' '--exclude=*.pyc' v9.9.5-before/tests/test_v995_outlier_scope_parity.py v9.9.5-after/tests/test_v995_outlier_scope_parity.py
--- v9.9.5-before/tests/test_v995_outlier_scope_parity.py	1970-01-01 00:00:00.000000000 +0000
+++ v9.9.5-after/tests/test_v995_outlier_scope_parity.py	2026-09-13 17:21:20.404601854 +0000
@@ -0,0 +1,82 @@
+import os
+import sys
+import ctypes
+from collections import deque
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+APP_PAYLOAD = Path(os.environ["APP_PAYLOAD"])
+sys.path.insert(0, str(APP_PAYLOAD))
+
+# Production is Windows-only. Provide the import-time user32 placeholder so this
+# narrow position-policy test can run on the source verification host.
+if not hasattr(ctypes, "windll"):
+    ctypes.windll = SimpleNamespace(user32=SimpleNamespace())
+
+from maple_nghia_pro import MapleNghiaPro
+from spotify_behavior_engine import SpotifyBehaviorEngine
+
+
+def make_host_with_position_state():
+    host = MapleNghiaPro.__new__(MapleNghiaPro)
+    engine = SpotifyBehaviorEngine.__new__(SpotifyBehaviorEngine)
+    engine.host = SimpleNamespace(last_tele_time=0.0, spotify_recovery_stage=0)
+    engine.last_map_position = (100.0, 100.0)
+    engine.last_detection_at = 1.0
+    engine.pending_jump = None
+    engine.pending_jump_count = 0
+    engine.rejected_position_jumps = 0
+    engine.position_confidence = 0.80
+    engine.position_streak = 3
+    engine.position_misses = 0
+    engine.position_history = deque([(100.0, 100.0)], maxlen=engine.POSITION_HISTORY)
+    host.behavior_engine = engine
+    return host, engine
+
+
+@pytest.mark.parametrize(
+    "current_map",
+    [
+        "C1",
+        "B1",
+        "B3",
+        "Bunny",
+        "Stand Still",
+        "C1 (Stand Still)",
+        "Red-Nose Pirate Den 2",
+        "Red-Nose Pirate Den 2 (1 Hit)",
+    ],
+)
+def test_non_c2_mainfarm_accepts_large_relocation_without_two_frame_guard(current_map):
+    host, engine = make_host_with_position_state()
+    cfg = {"current_map": current_map}
+
+    # A large vertical relocation would be rejected by Nghia's two-frame guard.
+    # Spotify parity for non-C2 must consume the detected position immediately.
+    result = host._spotify_main_farm_observe_position(cfg, (100.0, 190.0), 1.10)
+
+    assert result == (100.0, 190.0)
+    assert engine.last_map_position == (100.0, 190.0)
+    assert engine.pending_jump is None
+    assert engine.pending_jump_count == 0
+    assert engine.rejected_position_jumps == 0
+
+
+def test_c2_mainfarm_keeps_existing_two_frame_outlier_extension():
+    host, engine = make_host_with_position_state()
+    cfg = {"current_map": "C2"}
+
+    first = host._spotify_main_farm_observe_position(cfg, (100.0, 190.0), 1.10)
+    assert first is None
+    assert engine.last_map_position == (100.0, 100.0)
+    assert engine.pending_jump == (100.0, 190.0)
+    assert engine.pending_jump_count == 1
+    assert engine.rejected_position_jumps == 1
+
+    second = host._spotify_main_farm_observe_position(cfg, (100.0, 190.0), 1.20)
+    assert second == (100.0, 190.0)
+    assert engine.last_map_position == (100.0, 190.0)
+    assert engine.pending_jump is None
+    assert engine.pending_jump_count == 0
