+from pathlib import Path
+import sys
+
+APP_PAYLOAD = Path(__file__).resolve().parents[1] / "app_payload"
+if str(APP_PAYLOAD) not in sys.path:
+    sys.path.insert(0, str(APP_PAYLOAD))
+
+
+def _core_with_host():
+    from spotify_recovered_core import SpotifyRecoveredCore
+
+    class Host:
+        pass
+
+    host = Host()
+    core = SpotifyRecoveredCore(host)
+    host.spotify_input_last_role = "IDLE"
+    host.spotify_scheduler_last_action = ""
+    host.spotify_primary_held_key = None
+    host.spotify_primary_skill_next = 0.0
+    host.spotify_primary_last_action = 0.0
+    host.current_move_key = "RIGHT"
+    host.release_move = lambda: None
+    host.set_move = lambda key: None
+    host._log = lambda msg: None
+    host._release_all_owned_inputs = lambda: None
+    return core, host
+
+
+def test_c2_simple_uses_shared_hold_combo_not_dynamic_spam_candidate(monkeypatch):
+    import spotify_recovered_core as core_module
+    from spotify_recovered_core import SpotifyRecoveredCore
+
+    core, host = _core_with_host()
+    calls = []
+
+    def shared(self, cfg, direction_key, flash_key, skill_key, hold_time):
+        calls.append((direction_key, flash_key, skill_key, hold_time))
+        return True
+
+    def c2_special(*args, **kwargs):
+        raise AssertionError("C2 SIMPLE must not route to the Dynamic-Combo SPAM candidate")
+
+    monkeypatch.setattr(SpotifyRecoveredCore, "_spotify_hold_combo_action", shared)
+    monkeypatch.setattr(SpotifyRecoveredCore, "_spotify_c2_tp_skill_hold_combo", c2_special)
+    monkeypatch.setattr(core_module.random, "random", lambda: 0.5)
+    monkeypatch.setattr(core_module.random, "randint", lambda lo, hi: lo)
+    monkeypatch.setattr(core_module.time, "sleep", lambda sec: None)
+    monkeypatch.setattr(core_module.time, "monotonic", lambda: 10.0)
+
+    cfg = {
+        "current_map": "C2",
+        "spotify_runtime_parity_mode": True,
+        "spotify_attack_key": "A",
+        "tele_key": "X",
+        "tele_enabled": True,
+    }
+    assert core._spotify_primary_skill_step(cfg, 10.0) is True
+    assert calls == [("RIGHT", "X", "A", 0.2)]
+
+
+def test_shared_hold_combo_uses_attack_hold_range_and_no_random_move_waits(monkeypatch):
+    import spotify_recovered_core as core_module
+    from spotify_recovered_core import ATTACK_HOLD_MIN, ATTACK_HOLD_MAX, SpotifyRecoveredCore
+
+    core, host = _core_with_host()
+    now = [0.0]
+    taps = []
+
+    def tap(self, cfg, direction_key, action_key, hold_ms=45, role="ACTION"):
+        taps.append((action_key, hold_ms, role))
+        # Model the real input primitive consuming time; enough to end after one pair.
+        now[0] += 0.11
+        return True
+
+    monkeypatch.setattr(SpotifyRecoveredCore, "_spotify_tap_combo", tap)
+    monkeypatch.setattr(core_module.time, "monotonic", lambda: now[0])
+    monkeypatch.setattr(core_module.random, "randint", lambda lo, hi: lo)
+    monkeypatch.setattr(
+        core_module.random,
+        "uniform",
+        lambda *args: (_ for _ in ()).throw(
+            AssertionError("shared hold_combo_action must not borrow random_move waits")
+        ),
+    )
+
+    assert core._spotify_hold_combo_action({}, "RIGHT", "X", "A", 0.2) is True
+    assert taps == [
+        ("X", ATTACK_HOLD_MIN, "TELEPORT"),
+        ("A", ATTACK_HOLD_MIN, "ATTACK"),
+    ]
+    assert ATTACK_HOLD_MIN == 50
+    assert ATTACK_HOLD_MAX == 150
+
+
+def test_hold_combo_evidence_does_not_misattribute_random_move_waits():
+    import json
+
+    evidence = json.loads((APP_PAYLOAD / "evidence" / "hold_combo_action.json").read_text(encoding="utf-8"))
+    assert evidence["inner_action_hold_ms"] == [50, 150]
+    assert evidence["inner_action_hold_basis"] == "direct-global-attack-hold-constants-plus-structural-helper-shape"
+    assert "teleport_to_skill_wait_seconds" not in evidence
+    assert "post_skill_wait_seconds" not in evidence
+    assert evidence["dynamic_combo_spam_is_separate"] is True
+
+    from spotify_timing_catalog import SPOTIFY_RECONSTRUCTED_54
+    assert SPOTIFY_RECONSTRUCTED_54["random_move"]["gap_s"] == (0.015, 0.045)
+    assert SPOTIFY_RECONSTRUCTED_54["random_move"]["cycle_s"] == (0.125, 0.255)
