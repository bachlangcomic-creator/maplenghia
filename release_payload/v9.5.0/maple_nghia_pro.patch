+    def _spotify_find_exact_window(self, title):
+        """Resolve an exact title with FindWindowW only (no EnumWindows scan)."""
+        title = str(title or "").strip()
+        if not title:
+            return None
+        try:
+            hwnd = user32.FindWindowW(None, title)
+            return int(hwnd) if hwnd else None
+        except Exception as e:
+            self._last_input_error = f"Spotify FindWindowW: {e}"
+            return None
+
+    @staticmethod
+    def _spotify_get_foreground_window():
+        try:
+            hwnd = user32.GetForegroundWindow()
+            return int(hwnd) if hwnd else None
+        except Exception:
+            return None
+
+    def _spotify_force_focus_hwnd_parity(self, hwnd):
+        """Spotify-style lightweight focus restore used only by the 0.2s worker.
+
+        The original binary exposes FindWindowW/ShowWindow/SetWindowPos/
+        SetForegroundWindow around its dedicated focus worker.  Keep the heavier
+        AttachThreadInput/ALT workaround out of this parity path.
+        """
+        if not hwnd:
+            return False
+        try:
+            hwnd = int(hwnd)
+            user32.ShowWindow(hwnd, 9)  # SW_RESTORE
+            HWND_TOPMOST = -1
+            SWP_NOSIZE = 0x0001
+            SWP_NOMOVE = 0x0002
+            SWP_SHOWWINDOW = 0x0040
+            user32.SetWindowPos(
+                hwnd, HWND_TOPMOST, 0, 0, 0, 0,
+                SWP_NOSIZE | SWP_NOMOVE | SWP_SHOWWINDOW,
+            )
+            user32.SetForegroundWindow(hwnd)
+            return bool(user32.GetForegroundWindow() == hwnd)
+        except Exception as e:
+            self._last_input_error = f"Spotify focus parity: {e}"
+            return False
+
+    def _spotify_focus_refresh(self, cfg, force=True):
+        """Worker-side refresh. This is the only normal runtime Win32 focus lookup."""
+        cache = self.spotify_focus_cache
+        return bool(cache.refresh(
+            configured_title=str(cfg.get("window_title", "") or ""),
+            fixed_title=SPOTIFY_WINDOW_TITLE_EXACT,
+            force=bool(force),
+        ))
+
+    def _spotify_cached_game_has_focus(self):
+        """Hot-path focus read: no FindWindowW, EnumWindows or foreground API."""
+        return bool(self.spotify_focus_cache.cached_has_focus())
+
+    def _spotify_cached_game_hwnd(self):
+        return self.spotify_focus_cache.cached_hwnd()
