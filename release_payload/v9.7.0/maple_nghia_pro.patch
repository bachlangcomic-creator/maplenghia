     # -------------------------------
     # Detection / bot loop
     # -------------------------------
+    def _spotify_watchdog_interval(self, cfg):
+        # Nghĩa fallback cadence: Spotify watchdog timing has not been recovered.
+        fps = max(1.0, float(cfg.get("fps", 8.0)))
+        detect_every = max(1, int(cfg.get("detect_every", 1)))
+        return max(0.01, detect_every / fps)
+
+    def _spotify_watchdog_capture_frame(self, cfg, hwnd):
+        if not hwnd:
+            return None
+        return self.capture_screen(cfg["region"], fast=cfg.get("use_fast_capture", True))
+
+    def _spotify_watchdog_scan_frame(self, frame, cfg):
+        bgr = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)
+        gray = cv2.cvtColor(bgr, cv2.COLOR_BGR2GRAY)
+        results = []
+        specs = (
+            ("dead", "dead_template", "alert_threshold", "cached_dead"),
+            ("dc", "dc_template", "alert_threshold", "cached_dc"),
+            ("captcha", "captcha_template", "alert_threshold", "cached_captcha"),
+            ("full_bag", "full_template", "threshold", "cached_full"),
+        )
+        for kind, path_key, threshold_key, cache_name in specs:
+            path = str(cfg.get(path_key) or "").strip()
+            default_threshold = 0.86 if threshold_key == "alert_threshold" else 0.6
+            threshold = float(cfg.get(threshold_key, default_threshold))
+            box = (
+                self.find_best(gray, path, threshold, cfg.get("nms_distance", 35), cfg)
+                if path else None
+            )
+            setattr(self, cache_name, box)
+            score = float(box[0]) if box else 0.0
+            results.append(score_result(kind, score, threshold, SOURCE_NGHIA_FALLBACK))
+        return results
+
+    def _spotify_watchdog_emit(self, result: SpotifyDetectionResult, cfg):
+        if result.kind == "captcha":
+            if cfg.get("alert_captcha"):
+                self._handle_alert("captcha", "Phát hiện CAPTCHA / kiểm tra. Tool đã cảnh báo, không tự giải.", cfg)
+        elif result.kind == "dead":
+            if cfg.get("alert_dead"):
+                self._handle_alert("dead", "Phát hiện trạng thái nhân vật chết.", cfg)
+        elif result.kind == "dc":
+            if cfg.get("alert_dc"):
+                self._handle_alert("dc", "Phát hiện mất kết nối / hộp thoại kết nối.", cfg)
+        elif result.kind == "full_bag":
+            self.spotify_full_bag_event.set()
+
