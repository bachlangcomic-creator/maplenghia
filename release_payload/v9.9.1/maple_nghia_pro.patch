+    def _refresh_all_cure_status(self):
+        try:
+            state, detail = self.spotify_all_cure_market.readiness_status()
+            self.spotify_all_cure_status.set(f"ALL CURE: {state} — {detail}")
+            return state
+        except Exception as exc:
+            self.spotify_all_cure_status.set(f"ALL CURE: INVALID — {exc}")
+            return "INVALID"
+
+    def _import_all_cure_templates(self):
+        folder = filedialog.askdirectory(title="Chọn thư mục chứa đúng 12 ảnh All Cure")
+        if not folder:
+            return
+        source = Path(folder)
+        nested = source / "all_cure_images"
+        try:
+            direct_status = SpotifyAllCureAssetGateway(source).validate()
+            if not direct_status.ready and nested.is_dir():
+                source = nested
+            result = self.spotify_all_cure_market.gateway.import_from_directory(source)
+        except Exception as exc:
+            self._refresh_all_cure_status()
+            messagebox.showerror("All Cure", f"Không thể nạp template: {exc}")
+            return
+
+        state = self._refresh_all_cure_status()
+        if result.ready and state == "READY":
+            self._log("[Spotify All Cure] 12/12 templates imported; gateway READY.")
+            messagebox.showinfo("All Cure", "Đã nạp đủ 12 ảnh. All Cure gateway: READY.")
+            return
+        parts = []
+        if result.missing:
+            parts.append("Thiếu: " + ", ".join(result.missing))
+        if result.invalid:
+            parts.append("Ảnh lỗi: " + ", ".join(result.invalid))
+        messagebox.showwarning("All Cure", "Không thay đổi bộ ảnh hiện tại.\n" + ("\n".join(parts) or "Bộ template chưa hợp lệ."))
+
