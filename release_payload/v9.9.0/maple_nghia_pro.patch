+    def _spotify_market_asset_center(self, path, threshold, cfg=None):
+        try:
+            template = cv2.imread(str(path), cv2.IMREAD_GRAYSCALE)
+            if template is None:
+                return None
+            runtime = dict(cfg or self.runtime_cfg or {})
+            region = runtime.get("region")
+            if not region:
+                return None
+            frame = self.capture_screen(region, fast=runtime.get("use_fast_capture", True))
+            gray = cv2.cvtColor(frame, cv2.COLOR_RGB2GRAY) if getattr(frame, "ndim", 0) == 3 else frame
+            if gray is None or gray.shape[0] < template.shape[0] or gray.shape[1] < template.shape[1]:
+                return None
+            score_map = cv2.matchTemplate(gray, template, cv2.TM_CCOEFF_NORMED)
+            _min_v, max_v, _min_l, max_l = cv2.minMaxLoc(score_map)
+            if float(max_v) < float(threshold):
+                return None
+            return (
+                float(max_l[0] + template.shape[1] / 2.0),
+                float(max_l[1] + template.shape[0] / 2.0),
+            )
+        except Exception:
+            return None
+
+    def _spotify_market_find_asset(self, path, threshold):
+        return self._spotify_market_asset_center(path, threshold) is not None
+
+    def _spotify_market_wait_click(self, path, threshold, cfg):
+        if pydirectinput is None or not self._focus_game(cfg):
+            return False
+        center = self._spotify_market_asset_center(path, threshold, cfg)
+        if center is None:
+            return False
+        region = cfg.get("region") or (0, 0, 0, 0)
+        x = int(round(float(region[0]) + center[0]))
+        y = int(round(float(region[1]) + center[1]))
+        try:
+            pydirectinput.click(x=x, y=y)
+            return True
+        except Exception:
+            return False
+
