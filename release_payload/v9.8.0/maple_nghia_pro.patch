+    def _spotify_market_run_action(self, action_name, evidence, cfg):
+        # Side effects are serialized through the host and fail closed unless the
+        # reference transaction is complete. The supplied Spotify package does not
+        # contain its external all_cure_images assets, so V9.8 never guesses clicks.
+        self.behavior_engine.release_inputs()
+        self.c2_fast_supervisor_pause = True
+        record = evidence if isinstance(evidence, dict) else {}
+        if not record.get("complete"):
+            self._log(f"[Spotify All Cure] {action_name}: evidence/assets incomplete; action skipped.")
+            return False
+        self._log(f"[Spotify All Cure] {action_name}: executor unavailable without exact external assets.")
+        return False
