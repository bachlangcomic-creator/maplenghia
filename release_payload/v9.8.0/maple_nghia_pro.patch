+            pydirectinput.moveTo(x, y, duration=0.10)
+            pydirectinput.mouseDown()
+            time.sleep(0.05)
+            pydirectinput.mouseUp()
+            self.spotify_dead_center = None
+            self._log(f"[Spotify Revive] clicked evidenced DEAD center at ({x}, {y})")
+            return True
+        except Exception as exc:
+            try:
