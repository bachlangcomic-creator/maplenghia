+    def _spotify_watchdog_exact_template_match(self, image, asset_name):
+        raw = decode_exact_asset(asset_name)
+        template = cv2.imdecode(np.frombuffer(raw, dtype=np.uint8), cv2.IMREAD_GRAYSCALE)
+        if template is None:
+            return 0.0, None
+        if getattr(image, "ndim", 0) == 3:
+            gray = cv2.cvtColor(image, cv2.COLOR_RGB2GRAY)
+        else:
+            gray = image
+        if gray is None or gray.shape[0] < template.shape[0] or gray.shape[1] < template.shape[1]:
+            return 0.0, None
+        score_map = cv2.matchTemplate(gray, template, cv2.TM_CCOEFF_NORMED)
+        _min_v, max_v, _min_l, max_l = cv2.minMaxLoc(score_map)
+        center = (max_l[0] + template.shape[1] / 2.0, max_l[1] + template.shape[0] / 2.0)
+        return float(max_v), center
+
+    def _spotify_watchdog_exact_template_score(self, image, asset_name):
+        score, _center = self._spotify_watchdog_exact_template_match(image, asset_name)
+        return score
+
