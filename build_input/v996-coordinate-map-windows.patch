+def build_simple_map_profile(left, right, safe, threshold=0.6):
+    """Build one SIMPLE maps.json profile from three detected minimap points."""
+    lx, ly = left
+    rx, ry = right
+    sx, sy = safe
+    return {
+        "FARM_TYPE": "SIMPLE",
+        "LEFT_X": int(round(float(lx))),
+        "LEFT_Y": int(round(float(ly))),
+        "RIGHT_X": int(round(float(rx))),
+        "RIGHT_Y": int(round(float(ry))),
+        "SAFE_PLACE_X": int(round(float(sx))),
+        "SAFE_PLACE_Y": int(round(float(sy))),
+        "CHAR_MATCH_THRESHOLD": float(threshold),
+    }
+
+
+def save_map_profile(target_path, maps_data, name, profile):
+    """Persist one profile without mutating the caller's maps dictionary."""
+    target = Path(target_path)
+    merged = dict(maps_data or {})
+    merged[str(name)] = dict(profile or {})
+    target.parent.mkdir(parents=True, exist_ok=True)
+    temp = target.with_name(target.name + ".tmp")
+    temp.write_text(json.dumps(merged, ensure_ascii=False, indent=4) + "\n", encoding="utf-8")
+    os.replace(temp, target)
+    return merged
+
