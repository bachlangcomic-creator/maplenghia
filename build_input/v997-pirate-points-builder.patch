+def build_pirate_map_profile(
+    left, right, safe, loot_left, loot_right, loot_bot_1, loot_bot_2, threshold=0.6
+):
+    """Build one Pirate-route profile from captured farm and bottom-loot points."""
+    lx, ly = left
+    rx, ry = right
+    sx, sy = safe
+    llx, lly = loot_left
+    lrx, lry = loot_right
+    l1x, l1y = loot_bot_1
+    l2x, l2y = loot_bot_2
+    return {
+        "FARM_TYPE": "PIRATE_ROUTE",
+        "LEFT_X": int(round(float(lx))),
+        "LEFT_Y": int(round(float(ly))),
+        "RIGHT_X": int(round(float(rx))),
+        "RIGHT_Y": int(round(float(ry))),
+        "SAFE_PLACE_X": int(round(float(sx))),
+        "SAFE_PLACE_Y": int(round(float(sy))),
+        "LOOT_BOT_LEFT_X": int(round(float(llx))),
+        "LOOT_BOT_LEFT_Y": int(round(float(lly))),
+        "LOOT_BOT_RIGHT_X": int(round(float(lrx))),
+        "LOOT_BOT_RIGHT_Y": int(round(float(lry))),
+        "LOOT_BOT_1_X": int(round(float(l1x))),
+        "LOOT_BOT_1_Y": int(round(float(l1y))),
+        "LOOT_BOT_2_X": int(round(float(l2x))),
+        "LOOT_BOT_2_Y": int(round(float(l2y))),
+        "CHAR_MATCH_THRESHOLD": float(threshold),
+    }
+
